# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Coverage artifacts
.coverage
htmlcov/
frontend/coverage/

# Node
node_modules/
frontend/dist/
frontend/.env.local

# Built frontend copied into the backend for the prod image (produced in Docker)
backend/static/

# Env / secrets
.env
*.local

# Alembic scratch db (used to autogenerate the first migration)
backend/_alembic_tmp.db

# /design-sync — staged converter, build output, machine state.
# Everything else under .design-sync/ (config, notes, conventions, fonts) is committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Design handoff packages: HTML references plus a copy of the font files, sent
# over to be looked at. The system they mirror lives in frontend/src/styles.css.
design_handoff_*/

# OS / editor
.DS_Store
.vscode/
.idea/
.gstack/

# El .xls de CIQUAL (3,6 MB) se baja, no se versiona: `--download` lo trae de
# ANSES. La traducción sí se versiona — es el artefacto caro de la fase 0, y
# tenerla en el repo es lo que hace que rehacer la base de datos no cueste
# ochenta llamadas a un LLM.
backend/data/*
!backend/data/ciqual_es.json
!backend/data/es_parts/
backend/data/es_parts/*
!backend/data/es_parts/*.json
