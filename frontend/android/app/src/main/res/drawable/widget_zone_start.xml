<?xml version="1.0" encoding="utf-8"?>
<!-- El − de un marco de la fila de ajuste (4×2): nada en reposo y, al pulsar, el
     tinte con las dos esquinas de la izquierda del marco (radio 14 menos el borde). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_press" />
            <corners android:topLeftRadius="13dp" android:bottomLeftRadius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
