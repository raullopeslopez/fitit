<?xml version="1.0" encoding="utf-8"?>
<!-- El − de la fila de arriba: como widget_zone, con la esquina del marco (radio 14
     menos el borde) para que el tinte no se salga del bloque. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_press" />
            <corners android:topLeftRadius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
