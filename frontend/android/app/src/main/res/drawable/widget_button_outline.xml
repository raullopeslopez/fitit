<?xml version="1.0" encoding="utf-8"?>
<!-- «Abrir Fitit» de «Sesión caducada» (DESIGN.md): con borde y sin relleno, porque
     no registra nada y el ámbar es sólo de lo que registra o empieza. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/widget_border_strong" />
    <corners android:radius="12dp" />
</shape>
