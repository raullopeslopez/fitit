<?xml version="1.0" encoding="utf-8"?>
<!-- La notificación del entreno, cerrada (DESIGN.md, «La notificación del entreno»;
     APK 0.19.0): «Press banca» / «32,5 kg × 12 · 4 series» a la izquierda (la serie
     en Mono y tinta, el resto en muted) y, a la derecha, el tiempo en Mono 30sp y
     el aro de pausa. Cabecera y marco los pone
     Android (DecoratedCustomViewStyle): aquí no hay fondo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- La línea del ejercicio: lo único que abre la app (0.17.0). El cuerpo de la
         tarjeta ya no lo hace, para que un toque desviado con el móvil bloqueado
         no pida el código. -->
    <LinearLayout
        android:id="@+id/widget_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_exercise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/geist_semibold"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_mono_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />

            <include layout="@layout/widget_series" />
        </LinearLayout>
    </LinearLayout>

    <!-- El tiempo, Mono 30sp. La caja es la línea entera de la fuente (1,3 em):
         una caja de 30 dp le cortaba el pie a las cifras. El aire de más (4,5 dp
         por lado) se descuenta con márgenes negativos para que la fila siga
         midiendo lo que el texto de la izquierda. -->
    <Chronometer
        android:id="@+id/widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="-4.5dp"
        android:layout_marginBottom="-4.5dp"
        android:fontFamily="@font/geist_mono_medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="@color/widget_text"
        android:textSize="30sp" />

    <Chronometer
        android:id="@+id/widget_over"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="-4.5dp"
        android:layout_marginBottom="-4.5dp"
        android:fontFamily="@font/geist_mono_medium"
        android:format="+%s"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="@color/widget_accent_ink"
        android:textSize="30sp"
        android:visibility="gone" />

    <!-- En pausa (botón del 4×2 y del 3×2): lo que quedaba, quieto y en muted.
         Un texto y no un cronómetro parado: un cronómetro parado se recalcula
         cada vez que el launcher lo vuelve a pintar. -->
    <TextView
        android:id="@+id/widget_paused"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="-4.5dp"
        android:layout_marginBottom="-4.5dp"
        android:fontFamily="@font/geist_mono_medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="@color/widget_muted"
        android:textSize="30sp"
        android:visibility="gone" />

    <!-- Pausar el descanso: el aro neutro del widget, ❚❚ (▶ en pausa), sólo
         descansando (SessionWidget4x2.pause). -->
    <ImageView
        android:id="@+id/widget_rest_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginBottom="-4dp"
        android:contentDescription="@string/widget_rest_pause"
        android:scaleType="center"
        android:src="@drawable/widget_pause_ring"
        android:visibility="gone" />
</LinearLayout>
