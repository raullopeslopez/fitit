<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×2 del entreno (DESIGN.md, «Fuera de la app»; APK 0.19.0, «se lee como la
     serie»). Tres partes en vertical:
       a) «Press banca · 4 series» (tocarlo abre la app en ese entreno);
       b) una fila que ocupa el alto que sobra, centrada: el tiempo en Mono 40sp, que
          ocupa el ancho libre, el aro de pausa y el de Terminar;
       c) la fila de ajuste de 46 dp, [marco peso] [marco reps] [+1].
     Sin entreno (widget_idle), las pestañas; con la sesión caducada
     (widget_expired), sólo eso. Es el diseño de 300 dp de ancho y 190 de alto o
     más; por debajo de cualquiera de los dos, widget_session_4x2_compact, con los
     mismos ids. SessionWidget4x2 enseña un estado y esconde los demás, y pone los
     márgenes de cada uno; los textos de aquí son los de la vista previa del
     selector de widgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/widget_session"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- a) Ancho ajustado al contenido: así el nombre, con peso, sólo encoge (y
             se corta con …) cuando no cabe, y las series van pegadas detrás. -->
        <LinearLayout
            android:id="@+id/widget_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAlignedChildIndex="0"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_exercise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/geist_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Press banca"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp" />

                <include layout="@layout/widget_series" />

                <!-- Sólo con algo en la cola, y en ámbar: es un estado. -->
                <TextView
                    android:id="@+id/widget_unsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_accent_ink"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- b) El alto que sobra, con lo de dentro centrado en vertical. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- El tiempo ocupa el ancho libre; tocarlo abre la app, como la línea
                 de arriba, para que ese toque no se quede en los 18 dp del nombre.
                 La caja es la línea entera de la fuente (1,3 em): una caja del
                 tamaño del texto le cortaba el pie a las cifras. Baja en tinta;
                 pasado, sube en accent-ink con signo (+00:12); en pausa, quieto en
                 muted. Sin descanso, ninguno. -->
            <FrameLayout
                android:id="@+id/widget_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <Chronometer
                    android:id="@+id/widget_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_mono_medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_text"
                    android:textSize="40sp" />

                <Chronometer
                    android:id="@+id/widget_over"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_mono_medium"
                    android:format="+%s"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_accent_ink"
                    android:textSize="40sp"
                    android:visibility="gone" />

                <!-- Un texto y no un cronómetro parado: un cronómetro parado se
                     recalcula cada vez que el launcher lo vuelve a pintar. -->
                <TextView
                    android:id="@+id/widget_paused"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_mono_medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_muted"
                    android:textSize="40sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Pausar el descanso: un aro neutro con ❚❚ (▶ en pausa). Sólo
                 descansando. -->
            <ImageView
                android:id="@+id/widget_rest_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/widget_rest_pause"
                android:scaleType="center"
                android:src="@drawable/widget_pause_ring"
                android:visibility="gone" />

            <!-- Terminar: el aro rojo con ■. Los −5 dp lo llevan al borde: el aro de
                 34 queda dentro de los 44 de toque. -->
            <ImageView
                android:id="@+id/widget_end"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="-5dp"
                android:contentDescription="@string/widget_end"
                android:scaleType="center"
                android:src="@drawable/widget_end_ring" />
        </LinearLayout>

        <!-- c) -->
        <include layout="@layout/widget_adjust_row" />
    </LinearLayout>

    <include layout="@layout/widget_idle_tabs" />

    <include layout="@layout/widget_expired_block" />
</FrameLayout>
