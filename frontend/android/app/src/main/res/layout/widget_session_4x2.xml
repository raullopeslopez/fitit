<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×2 del entreno (docs/widgets-entreno.md, «4×2, con ajuste»), como en
     la maqueta aprobada. Tres filas: el ejercicio con su reloj y ⏭; peso y reps
     con sus − y +; «Registrar serie», «Otro ejercicio» y «Terminar». «Otro
     ejercicio» abre la app para añadir uno. Sin sesión (widget_idle), lo
     mismo que el 4×1 pero apilado. SessionWidget4x2 enseña un estado y esconde el otro; los
     textos de aquí son los de la vista previa del selector de widgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:id="@+id/widget_session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <!-- Fila 1: ejercicio y series a la izquierda; reloj y ⏭ a la derecha. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <!-- Tocar el ejercicio abre la app en ese entreno. -->
            <LinearLayout
                android:id="@+id/widget_open"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_exercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_grotesk_semibold"
                        android:maxLines="1"
                        android:text="Press banca"
                        android:textColor="@color/widget_text"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/geist_mono_medium"
                        android:maxLines="1"
                        android:text="4 series"
                        android:textColor="@color/widget_muted"
                        android:textSize="13sp" />

                    <!-- Sólo con algo en la cola, y en ámbar: es un estado. -->
                    <TextView
                        android:id="@+id/widget_unsent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/geist_mono_medium"
                        android:maxLines="1"
                        android:textColor="@color/widget_accent_ink"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <Chronometer
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/geist_mono_semibold"
                android:textColor="@color/widget_text"
                android:textSize="24sp" />

            <ImageView
                android:id="@+id/widget_skip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_stepper"
                android:contentDescription="@string/widget_skip"
                android:scaleType="center"
                android:src="@drawable/ic_widget_skip" />

            <TextView
                android:id="@+id/widget_rest_over"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/geist_semibold"
                android:text="@string/widget_rest_over"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Fila 2: − peso +   − reps +. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_weight_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_weight_down"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_stepper"
                    android:contentDescription="@string/widget_weight_down"
                    android:fontFamily="@font/geist_mono_medium"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/widget_text"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/widget_weight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/geist_mono_medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="32,5 kg"
                    android:textColor="@color/widget_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/widget_weight_up"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_stepper"
                    android:contentDescription="@string/widget_weight_up"
                    android:fontFamily="@font/geist_mono_medium"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/widget_accent_ink"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_reps_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_reps_down"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_stepper"
                    android:contentDescription="@string/widget_reps_down"
                    android:fontFamily="@font/geist_mono_medium"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/widget_text"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_reps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/geist_mono_medium"
                        android:maxLines="1"
                        android:text="12"
                        android:textColor="@color/widget_text"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/geist_regular"
                        android:text="@string/widget_reps_unit"
                        android:textColor="@color/widget_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_reps_up"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_stepper"
                    android:contentDescription="@string/widget_reps_up"
                    android:fontFamily="@font/geist_mono_medium"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/widget_accent_ink"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fila 3: Registrar serie · Otro ejercicio · Terminar. Los dos de la
             derecha, texto apagado: son lo raro, y el botón lleno es lo de cada serie. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_log"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button"
                android:ellipsize="end"
                android:fontFamily="@font/geist_semibold"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/widget_log"
                android:textColor="@color/widget_on_accent"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_other"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/geist_regular"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/widget_other"
                android:textColor="@color/widget_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_end"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:fontFamily="@font/geist_regular"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="@string/widget_end"
                android:textColor="@color/widget_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sin sesión, apilado: en el 4×2 hay alto de sobra y así el título no se
         parte en dos líneas. -->
    <LinearLayout
        android:id="@+id/widget_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_idle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_semibold"
            android:maxLines="1"
            android:text="@string/widget_idle_title"
            android:textColor="@color/widget_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_idle_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/geist_regular"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_start"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/widget_button"
            android:fontFamily="@font/geist_semibold"
            android:gravity="center"
            android:text="@string/widget_start"
            android:textColor="@color/widget_on_accent"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
