<?xml version="1.0" encoding="utf-8"?>
<!-- El bloque de ajuste apilado (DESIGN.md, «El bloque de ajuste»): el del 3×2 y de
     cualquier widget compacto (< 300 dp de ancho o < 190 de alto), donde no cabe la
     fila de dos marcos (widget_adjust_row). Dos filas de 44 dp —el mínimo de toque—
     apiladas (− 32,5 kg +, − × 12 +) y el +1 como su extremo derecho, 56 dp de ancho
     y todo el alto, a 6 dp de las filas. Los − y + tocan en 44 dp: a 52, en los
     ≈253 dp del Xiaomi, un «102,5 kg» pisaba el −. Marco común de 1 dp border-strong
     y radio 14, filete de 1 dp border entre filas. Las leyendas son las de la fila:
     «kg» detrás, «×» delante y sin «reps». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_block"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_block"
    android:orientation="horizontal"
    android:padding="1dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Sin peso (dominadas) esta fila y el filete se esconden. -->
        <LinearLayout
            android:id="@+id/widget_weight_box"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_weight_down"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_zone_top_start"
                android:contentDescription="@string/widget_weight_down"
                android:fontFamily="@font/geist_mono_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="−"
                android:textColor="@color/widget_glyph"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_mono_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="32,5"
                    android:textColor="@color/widget_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/geist_regular"
                    android:includeFontPadding="false"
                    android:text="@string/widget_weight_unit"
                    android:textColor="@color/widget_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_weight_up"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_zone"
                android:contentDescription="@string/widget_weight_up"
                android:fontFamily="@font/geist_mono_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="@color/widget_glyph"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- FrameLayout y no View: un widget sólo admite las vistas de RemoteViews. -->
        <FrameLayout
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_border" />

        <LinearLayout
            android:id="@+id/widget_reps_box"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_reps_down"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_zone_bottom_start"
                android:contentDescription="@string/widget_reps_down"
                android:fontFamily="@font/geist_mono_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="−"
                android:textColor="@color/widget_glyph"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_mono_medium"
                    android:includeFontPadding="false"
                    android:text="@string/widget_reps_sign"
                    android:textColor="@color/widget_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_reps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/geist_mono_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="12"
                    android:textColor="@color/widget_text"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_reps_up"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_zone"
                android:contentDescription="@string/widget_reps_up"
                android:fontFamily="@font/geist_mono_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="@color/widget_glyph"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- El +1: el único relleno ámbar, 56 dp. Dice sólo +1: la serie ya está escrita
         a su izquierda. A 6 dp del + de los kilos (0.17.0): pegados, un toque
         desviado registraba una serie. -->
    <TextView
        android:id="@+id/widget_log"
        android:layout_width="56dp"
        android:layout_marginStart="6dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_plus_one"
        android:contentDescription="@string/widget_log"
        android:fontFamily="@font/geist_mono_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/widget_plus_one"
        android:textColor="@color/widget_on_accent"
        android:textSize="20sp" />
</LinearLayout>
