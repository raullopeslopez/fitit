<?xml version="1.0" encoding="utf-8"?>
<!-- La notificación del entreno, desplegada (vista previa v17, N4): la línea
     «Press banca · 4 series», el tiempo en Mono 34sp y el mismo bloque de ajuste
     del widget, para cambiar peso y reps y registrar sin abrir la app. Sin botones
     del sistema: el bloque ocupa su sitio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_exercise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/geist_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- El tiempo, Mono 34sp. La caja es la línea entera de la fuente (1,3 em):
         una caja de 34 dp le cortaba el pie a las cifras. Los márgenes descuentan
         el aire de más (5 dp por lado): a la vista, 6 dp a la línea y 10 al bloque. -->
    <Chronometer
        android:id="@+id/widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="-5dp"
        android:fontFamily="@font/geist_mono_medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="@color/widget_text"
        android:textSize="34sp" />

    <Chronometer
        android:id="@+id/widget_over"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="-5dp"
        android:fontFamily="@font/geist_mono_medium"
        android:format="+%s"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="@color/widget_accent_ink"
        android:textSize="34sp"
        android:visibility="gone" />

    <!-- En pausa (botón del 4×2 y del 3×2): lo que quedaba, quieto y en muted.
         Un texto y no un cronómetro parado: un cronómetro parado se recalcula
         cada vez que el launcher lo vuelve a pintar. -->
    <TextView
        android:id="@+id/widget_paused"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="-5dp"
        android:fontFamily="@font/geist_mono_medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="@color/widget_muted"
        android:textSize="34sp"
        android:visibility="gone" />

    <include
        layout="@layout/widget_adjust_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp" />
</LinearLayout>
