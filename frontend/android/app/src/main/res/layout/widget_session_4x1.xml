<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×1 del entreno (DESIGN.md, «El 4×1»). Con sesión: «Press banca» /
     «32,5 kg × 12 · 4 series» y el +1 a la derecha; descansando, el tiempo en Mono
     30sp a la izquierda, delante del nombre. Sin sesión (widget_idle), título y
     botón. SessionWidget enseña un estado y esconde el otro; los textos de aquí
     son los de la vista previa del selector de widgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/widget_session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tocar el ejercicio abre la app en ese entreno. -->
        <LinearLayout
            android:id="@+id/widget_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Chronometer
                    android:id="@+id/widget_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/geist_mono_medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_text"
                    android:textSize="30sp" />

                <!-- Pasado de tiempo: accent-ink y hacia arriba, +00:12. -->
                <Chronometer
                    android:id="@+id/widget_over"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/geist_mono_medium"
                    android:format="+%s"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_accent_ink"
                    android:textSize="30sp"
                    android:visibility="gone" />

                <!-- En pausa (botón del 4×2 y del 3×2): lo que quedaba, quieto y en muted.
                     Un texto y no un cronómetro parado: un cronómetro parado se recalcula
                     cada vez que el launcher lo vuelve a pintar. -->
                <TextView
                    android:id="@+id/widget_paused"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/geist_mono_medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_muted"
                    android:textSize="30sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_exercise"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/geist_semibold"
                    android:maxLines="1"
                    android:text="Press banca"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_mono_medium"
                    android:maxLines="1"
                    android:text="32,5 kg × 12"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/geist_regular"
                    android:maxLines="1"
                    android:text=" · 4 series"
                    android:textColor="@color/widget_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_repeat"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/widget_log"
            android:fontFamily="@font/geist_mono_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/widget_plus_one"
            android:textColor="@color/widget_on_accent"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_idle_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_semibold"
                android:text="@string/widget_idle_title"
                android:textColor="@color/widget_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_idle_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_regular"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_start"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_button"
            android:fontFamily="@font/geist_semibold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/widget_start"
            android:textColor="@color/widget_on_accent"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Sesión caducada: el título y «Abrir», con borde y sin relleno. -->
    <LinearLayout
        android:id="@+id/widget_expired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_expired_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/space_grotesk_semibold"
            android:maxLines="1"
            android:text="@string/widget_expired_title"
            android:textColor="@color/widget_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_reopen"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_button_outline"
            android:fontFamily="@font/geist_semibold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/widget_reopen_short"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
