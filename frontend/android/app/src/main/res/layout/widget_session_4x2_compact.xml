<?xml version="1.0" encoding="utf-8"?>
<!-- El 4×2 compacto: el 3×2, y cualquier widget de menos de 300 dp de ancho o de 190
     de alto (SessionWidget4x2.Fit; DESIGN.md, «Tamaños»). Ahí no cabe la fila de dos
     marcos, y se queda el diseño anterior: arriba, en una línea, «Press banca ·
     4 series», el tiempo a su derecha en Mono 24sp (a 30 no cabía ni el nombre en
     ≈253 dp), el aro de pausa y Terminar; debajo, a 8 dp, el bloque apilado de dos
     filas de 44 y el +1 de 56 a la derecha. Márgenes de 10 arriba y abajo. Los ids
     son los de widget_session_4x2: el mismo código rellena los dos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/widget_session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <!-- Tocar el ejercicio abre la app en ese entreno. -->
            <LinearLayout
                android:id="@+id/widget_open"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/widget_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAlignedChildIndex="0"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_exercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/geist_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Press banca"
                        android:textColor="@color/widget_text"
                        android:textSize="15sp" />

                    <include layout="@layout/widget_series" />

                    <TextView
                        android:id="@+id/widget_unsent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/geist_regular"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_accent_ink"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- El tiempo, a la derecha del nombre. Baja en tinta; pasado, sube en
                 accent-ink con signo; en pausa, un texto quieto en muted. -->
            <Chronometer
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/geist_mono_medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text"
                android:textSize="24sp"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/widget_over"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/geist_mono_medium"
                android:format="+%s"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/widget_accent_ink"
                android:textSize="24sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_paused"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/geist_mono_medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/widget_muted"
                android:textSize="24sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_rest_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/widget_rest_pause"
                android:scaleType="center"
                android:src="@drawable/widget_pause_ring"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_end"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="-5dp"
                android:contentDescription="@string/widget_end"
                android:scaleType="center"
                android:src="@drawable/widget_end_ring" />
        </LinearLayout>

        <include
            layout="@layout/widget_adjust_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <include layout="@layout/widget_idle_tabs" />

    <include layout="@layout/widget_expired_block" />
</FrameLayout>
