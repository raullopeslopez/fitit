<?xml version="1.0" encoding="utf-8"?>
<!-- Los widgets y la notificación del entreno, tema claro: los colores de DESIGN.md
     («Fuera de la app»). El oscuro está en values-night; Android elige según el
     tema del sistema. -->
<resources>
    <color name="widget_bg">#FFFFFF</color>
    <color name="widget_border">#E6E2DA</color>
    <!-- El marco del bloque de ajuste y los puntitos apagados. -->
    <color name="widget_border_strong">#C9C3B8</color>
    <color name="widget_text">#16181B</color>
    <color name="widget_muted">#616875</color>
    <color name="widget_accent">#E4571B</color>
    <!-- El ámbar como texto (accent-ink en DESIGN.md): «1 sin enviar», el tiempo
         pasado, el glifo pulsado. -->
    <color name="widget_accent_ink">#C2440F</color>
    <color name="widget_on_accent">#16181B</color>
    <!-- Terminar: rojo porque no se deshace (danger en DESIGN.md). -->
    <color name="widget_danger">#CE1F1F</color>
    <!-- La zona de un − o + mientras se pulsa: suave, no sólida, para que el + de
         los kilos no se funda con el +1 de al lado. -->
    <color name="widget_press">#FBE6DC</color>
    <!-- El récord (pr en DESIGN.md): el anillo de proteína al cerrar el día. -->
    <color name="widget_pr">#A83208</color>
    <!-- Los grupos musculares (los m-* de styles.css), para la franja de la pestaña
         Entreno. Sólo marca, nunca texto: no todos pasan el contraste de lectura. -->
    <color name="widget_m_pecho">#2A78D6</color>
    <color name="widget_m_espalda">#008300</color>
    <color name="widget_m_cuadriceps">#E87BA4</color>
    <color name="widget_m_gluteo">#7D3F17</color>
    <color name="widget_m_femoral">#8B4BC0</color>
    <color name="widget_m_gemelo">#0089A0</color>
    <color name="widget_m_hombro">#EDA100</color>
    <color name="widget_m_biceps">#1BAF7A</color>
    <color name="widget_m_triceps">#4A3AA7</color>
    <color name="widget_m_core">#E34948</color>
</resources>
