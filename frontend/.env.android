# Build del APK (`npm run android:build`, que es `vite build --mode android`).
# Nada de aquí es secreto: los dos valores viajan dentro del JS que Render sirve.
#
# La interfaz va dentro del APK y la API no, así que las peticiones llevan el
# origen completo (platform/http.js). El backend acepta el origen del APK por CORS.
VITE_API_BASE=https://fitit-n4q0.onrender.com
# El ID de cliente **web**, el mismo que la PWA: es la audiencia que comprueba
# `/auth/google`, también para el login nativo (platform/googleIdentity.js).
VITE_GOOGLE_CLIENT_ID=387241176763-575a6in29ngtjouqtf9rd0nd6975q4iq.apps.googleusercontent.com
