# Copy to backend/.env for running the API on the host.
# `docker compose up` sets these itself, so you only need this for host-only runs.
ENV=local
DATABASE_URL=postgresql+asyncpg://fitit:fitit@localhost:5432/fitit
JWT_SECRET=dev-secret-change-me
AUTH_USERNAME=fitit
AUTH_PASSWORD=changeme
# Google sign-in. Empty = feature off (the button disappears, /auth/google refuses).
GOOGLE_CLIENT_ID=
# Read once by the add_google_sign_in migration, to link the seeded account
# above to a Google account by email. See README.
AUTH_EMAIL=
